#!/usr/bin/env bash
# Git commit-msg hook enforcing multi-agent commit attribution trailers

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Allow merge commits generated by git internally (Merge branch...)
if echo "$COMMIT_MSG" | grep -qE '^Merge branch '; then
  exit 0
fi

# Check for mandatory Agent-Model trailer
if ! grep -qE '^Agent-Model: ' "$COMMIT_MSG_FILE"; then
  echo ""
  echo "================================================================================"
  echo " [SEKHEMET GIT HOOK] ERROR: Commit rejected due to missing attribution trailer!"
  echo "================================================================================"
  echo " All commits in this repository must contain mandatory multi-agent attribution."
  echo " Missing required trailer: 'Agent-Model: <model-id>'"
  echo ""
  echo " Example commit trailer block:"
  echo "   Card: card_8f21"
  echo "   Agent-Model: claude-3-7-sonnet-20250219"
  echo "   Agent-Harness: claude-code"
  echo "   Agent-Role: implementer"
  echo "   Co-authored-by: Claude <claude@anthropic.com>"
  echo ""
  echo " Refer to AGENTS.md or CLAUDE.md for full specification."
  echo "================================================================================"
  echo ""
  exit 1
fi

exit 0
