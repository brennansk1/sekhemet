{
  "name": "sekhemet",
  "license": "FSL-1.1-ALv2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsc -b",
    "clean": "pnpm -r exec rm -rf dist *.tsbuildinfo",
    "dashboard": "node apps/harness/dist/index.js serve",
    "dev": "node scripts/dev.mjs",
    "format": "biome check --write .",
    "gate": "pnpm exec tsc -b && pnpm exec biome check . && pnpm exec vitest run",
    "lint": "biome check .",
    "sekhemet": "node apps/harness/dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "release-gate": "node scripts/release_gate.mjs",
    "milestone": "node scripts/milestones/run.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "1.61.1",
    "axe-core": "4.13.0",
    "playwright-core": "1.61.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
